        <item>
            <title>1.11.4</title>
            <pubDate>Tue, 10 Nov 2026 08:23:49 +0100</pubDate>
            <sparkle:version>493</sparkle:version>
            <sparkle:shortVersionString>1.11.4</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[- Motion now starts more smoothly on 120 Hz displays.
- Butterfly now uses your Mac's accent color in the menu, Settings, the tour and the license window.
- Settings, the tour and the practice strip share one set of greys and one corner scale.
- Clearer names: "New workspace", "Start at login" and "Tour…".
]]></description>
            <enclosure url="https://github.com/butterflyformac/releases/releases/download/v1.11.4/Butterfly-1.11.4.zip" length="3961664" type="application/octet-stream" sparkle:edSignature="FxfHuPD5x68zrzVUkCbiojm0UmQcRbCGCO7CDetl78EZxWGT8JeG6Kkfq6JZR3BIT2GfqheA56dD2JeWisWmBw=="/>
        </item>
        <item>
            <title>1.11.1</title>
            <pubDate>Sun, 08 Nov 2026 15:29:25 +0100</pubDate>
            <sparkle:version>484</sparkle:version>
            <sparkle:shortVersionString>1.11.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[- Press the mouse wheel and move up to open Overview, or down to show the desktop.
- Moving all windows of a workspace in Overview now takes you to that workspace.
- Flapping icons in Overview and on the desktop no longer show a frame.
- Butterfly now comes as a disk image: open it and drag Butterfly to Applications.
]]></description>
            <enclosure url="https://github.com/butterflyformac/releases/releases/download/v1.11.1/Butterfly-1.11.1.zip" length="3963728" type="application/octet-stream" sparkle:edSignature="n6OtZiQMovXHipSed0KmjnrDLVrFJ1xp1V3Jwhsg1pt5ovPQDrxAjJC1fp99LzawuVDR5WXhcXEV3RG5/MUeBQ=="/>
